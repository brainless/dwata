{
  "$schema": "../../../tauri/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Dwata",
  "version": "0.6.0",
  "identifier": "com.dwata.app",
  "build": {
    "frontendDist": "../../gui/dist",
    "devUrl": "http://localhost:39283",
    "beforeDevCommand": "cargo build -p dwata-api --bin dwata-api && npm --prefix ../gui run dev",
    "beforeBuildCommand": "npm --prefix ../gui run build",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Dwata",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "../bin/dwata-api"
    ],
    "icon": []
  }
}
